FROM registry.redhat.io/rhbk/keycloak-rhel9:26.6 AS builder

# Build-time options: they are baked into the optimized image and must match the
# Keycloak CR (base/keycloak/keycloak.yaml), since the operator starts a custom image with --optimized.
ENV KC_DB=postgres
ENV KC_HEALTH_ENABLED=true
ENV KC_METRICS_ENABLED=true
# User event metrics (logins, login errors, token issuance... per realm): the feature AND
# event-metrics-user-enabled are both build-time options (an optimized image refuses to start
# if the CR asks for a different value). The CR declares the same feature (spec.features).
ENV KC_FEATURES=user-event-metrics
ENV KC_EVENT_METRICS_USER_ENABLED=true
# Traces (OpenTelemetry): build-time option. Endpoint and sampler ratio are runtime options
# (spec.tracing in the Keycloak CR, set by the platform collector address).
ENV KC_TRACING_ENABLED=true

WORKDIR /opt/keycloak

# Enable custom theme.
# COPY ./themes/my-theme/ /opt/keycloak/themes/my-theme

# Add the provider JAR file to the providers directory
# ADD --chown=keycloak:keycloak --chmod=644 <MY_PROVIDER_JAR_URL> /opt/keycloak/providers/myprovider.jar

RUN /opt/keycloak/bin/kc.sh build


FROM registry.redhat.io/rhbk/keycloak-rhel9:26.6
COPY --from=builder /opt/keycloak/ /opt/keycloak/

ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
